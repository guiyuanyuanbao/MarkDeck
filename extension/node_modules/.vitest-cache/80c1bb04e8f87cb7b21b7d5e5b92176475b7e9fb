// Multi-device sync test: runs the REAL built extension bundle twice, each in
// its own chrome.* sandbox with independent storage + bookmark tree.
// Requires a running MarkDeck server (MARKDECK_TEST_SERVER env, default :8996).
const { createDevice, runExtensionCode } = require('./helpers/chrome-sandbox.js');
const fs = require('fs');
const path = require('path');

const SERVER = process.env.MARKDECK_TEST_SERVER || 'http://127.0.0.1:8996';
const ADMIN_PW = process.env.MARKDECK_TEST_PASSWORD || 'qa-multi-client-2026';

const results = [];
function log(name, ok, detail = '') {
  results.push({ name, ok, detail });
  console.log((ok ? '✓' : '✗ FAIL'), name, detail)
}

async function api(path, body, headers = {}) {
  const r = await fetch(SERVER + path, {
    method: body === undefined ? 'GET' : 'POST',
    headers: { ...(body ? { 'Content-Type': 'application/json' } : {}), ...headers },
    body: body ? JSON.stringify(body) : undefined,
  });
  return { status: r.status, body: await r.text(), cookies: r.headers.getSetCookie() }
}

let cookie, csrf;

async function pairCode() {
  const r = await api('/api/pair-code', {}, { Cookie: cookie, 'X-CSRF': csrf });
  if (r.status !== 200) throw new Error('pair-code HTTP ' + r.status + ': ' + r.body.slice(0, 120));
  return JSON.parse(r.body).code
}

async function pairDevice(dev, code, name) {
  // configure the device exactly like options.js → runtime 'pair' message
  const resp = await fetch(SERVER + '/api/pair', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ code, name }),
  });
  const data = await resp.json();
  if (!resp.ok) throw new Error('pair failed: ' + data.error);
  await dev.chrome.storage.local.set({
    md_config: { server: SERVER, token: data.token, deviceId: data.deviceId, rev: 0 },
  });
  return data
}

async function waitFor(fn, timeoutMs = 15000, intervalMs = 250) {
  const start = Date.now();
  while (Date.now() - start < timeoutMs) {
    if (await fn()) return true;
    await new Promise(r => setTimeout(r, intervalMs))
  };
  return false
}

function titlesOf(dev) {
  const out = [];
  for (const n of dev.store.nodes.values()) if (n.url) out.push(n.title);
  return out
}

;(async () => {
  // ---- server bootstrap ----
  let state = JSON.parse((await api('/api/auth/state')).body);
  if (state.setup) {
    const s = await api('/api/auth/setup', { password: ADMIN_PW });
    cookie = s.cookies[0].split(';')[0];
    csrf = JSON.parse(s.body).csrf
  } else {
    const l = await api('/api/auth/login', { password: ADMIN_PW });
    if (l.status !== 200) throw new Error('cannot login (wrong test password?)');
    cookie = l.cookies[0].split(';')[0];
    csrf = JSON.parse(l.body).csrf
  };
  log('server auth ready', true);

  // ---- device A ----
  // run the REAL bundle twice — each import registers listeners against
  // whatever globalThis.chrome is at import time (bundle reads chrome.*
  // dynamically per call, so we swap the global around each load + use).
  const devA = createDevice('device-A');
  globalThis.chrome = devA.chrome;
  const { runExtensionCode } = require('./helpers/chrome-sandbox.js');
  await runExtensionCode(devA);
  const devB = createDevice('device-B');
  globalThis.chrome = devB.chrome;
  await runExtensionCode(devB);

  // ---- pair both devices (server keeps one active code at a time, so
  // generate -> consume serially) ----
  const codeA = await pairCode();
  const dataA = await pairDevice(devA, codeA, 'Edge-A');
  const codeB = await pairCode();
  const dataB = await pairDevice(devB, codeB, 'Edge-B');
  log('A paired', !!dataA.deviceId, dataA.deviceId?.slice(0, 8));
  log('B paired', !!dataB.deviceId, dataB.deviceId?.slice(0, 8));
  log('distinct device ids', dataA.deviceId !== dataB.deviceId);

  // ---- A creates a bookmark → B should receive it ----
  const created = await devA.store.create({ title: 'A 创建的书签', url: 'https://a-device.test/one' });
  // trigger A's extension message 'resync' to flush its queue to server
  await new Promise((resolve) => {
    devA.runtimeEvents.emit('message', { type: 'resync' }, {}, resolve)
  });
  // wait for B to pull and apply (also nudge B's resync — in a real browser
  // the WS rev ping would trigger it automatically)
  await new Promise((resolve) => devB.runtimeEvents.emit('message', { type: 'resync' }, {}, resolve));
  const gotByB = await waitFor(() =>
    titlesOf(devB).includes('A 创建的书签'), 20000);
  log('B receives bookmark created on A', gotByB,
    gotByB ? '' : `B titles: ${JSON.stringify(titlesOf(devB))}`);

  // ---- B deletes it → A should learn the deletion ----
  const bNode = [...devB.store.nodes.values()].find(n => n.title === 'A 创建的书签');
  if (bNode) {
    await devB.store.removeTree(bNode.id);
    await new Promise((resolve) => devB.runtimeEvents.emit('message', { type: 'resync' }, {}, resolve))
  };
  const deletedInA = await waitFor(() =>
    !titlesOf(devA).includes('A 创建的书签'), 20000);
  log('A learns deletion from B', deletedInA,
    deletedInA ? '' : `A titles: ${JSON.stringify(titlesOf(devA))}`);

  // ---- conflict: both edit same bookmark; later timestamp wins ----
  const base = await devA.store.create({ title: '冲突基准', url: 'https://conflict.test' });
  await new Promise((resolve) => devA.runtimeEvents.emit('message', { type: 'resync' }, {}, resolve));
  await waitFor(() => titlesOf(devB).includes('冲突基准'), 20000);
  // A writes at T, B writes at T+2
  await devA.store.update(base.id, { title: 'A 的修改' });
  await new Promise(r => setTimeout(r, 1200));
  const bBase = [...devB.store.nodes.values()].find(n => n.title === '冲突基准');
  if (bBase) await devB.store.update(bBase.id, { title: 'B 的修改（更晚）' });
  // flush both
  await new Promise((resolve) => devA.runtimeEvents.emit('message', { type: 'resync' }, {}, resolve));
  await new Promise((resolve) => devB.runtimeEvents.emit('message', { type: 'resync' }, {}, resolve));
  const converged = await waitFor(async () => {
    await new Promise((resolve) => devA.runtimeEvents.emit('message', { type: 'resync' }, {}, resolve));
    const ta = titlesOf(devA), tb = titlesOf(devB);
    return ta.includes('B 的修改（更晚）') && tb.includes('B 的修改（更晚）')
  }, 25000);
  log('conflict resolves to latest writer (LWW)', converged,
    converged ? '' : `A: ${JSON.stringify(titlesOf(devA))} B: ${JSON.stringify(titlesOf(devB))}`);

  console.log('\n=== RESULT ===');
  console.log(`${results.filter(r => r.ok).length} passed, ${results.filter(r => !r.ok).length} failed`);
  process.exit(results.every(r => r.ok) ? 0 : 1)
})()

