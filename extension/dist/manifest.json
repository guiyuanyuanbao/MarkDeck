{
  "manifest_version": 3,
  "name": "MarkDeck 同步",
  "version": "0.1.17",
  "description": "MarkDeck 自托管书签同步服务配套插件：双向同步、离线可用、快速收藏。",
  "permissions": [
    "bookmarks",
    "storage",
    "alarms",
    "favicon"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MarkDeck",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options.html",
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
